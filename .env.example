# Auth.js
AUTH_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase/Neon Postgres
DATABASE_URL=

# Email verification (6-digit OTP for new E-JUST accounts)
# Provider order: Resend -> SMTP -> Gmail API. In development, if none is set,
# the code is logged to the server console instead. In production, signup
# returns 503 until at least one provider works.
RESEND_API_KEY=
# Sender address, e.g. "E-JUST Hub <no-reply@ejust.edu.eg>" or "no-reply@ejust.edu.eg"
EMAIL_FROM=

# Optional SMTP transport (used when RESEND_API_KEY is absent/fails).
# SMTP_SECURE=true means implicit TLS (normally port 465); otherwise STARTTLS
# is negotiated when the server advertises it (normally port 587).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# Scheduled Gmail -> Neon digest sync (every 30 minutes via vercel.json)
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"; the route is a no-op
# when any of the Gmail variables below is missing.
# The same credentials are also the final fallback for verification email.
CRON_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: model used for Gmail/OpenAI extraction (defaults to gpt-4o-mini)
GMAIL_AI_MODEL=
OPENAI_EXAM_MODEL=
